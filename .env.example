# Swara Environment Configuration Example
# Copy to .env and customize as needed

# Host and Port
SWARA_API_HOST=127.0.0.1
SWARA_API_PORT=8000

# Optional API Key for authentication (leave empty for unauthenticated local development)
SWARA_API_KEY=

# Storage Paths
SWARA_MODELS_DIR=models/cache
SWARA_SPEAKER_STORE_PATH=data/speakers

# Inference Hardware & Optimization
SWARA_EXECUTION_PROVIDER=CPUExecutionProvider
SWARA_INTRA_OP_NUM_THREADS=4
SWARA_INTER_OP_NUM_THREADS=2
SWARA_USE_INT8_MODEL=false

# Algorithm Thresholds
SWARA_IDENTIFICATION_THRESHOLD=0.68
SWARA_UNKNOWN_THRESHOLD=0.60
SWARA_DIARIZATION_CLUSTERING_THRESHOLD=0.65
SWARA_DIARIZATION_IDENTITY_MATCH_THRESHOLD=0.70

# Limits
SWARA_MAX_AUDIO_DURATION_SECONDS=1800.0
SWARA_MAX_AUDIO_UPLOAD_SIZE_MB=50.0
SWARA_RATE_LIMIT_PER_MINUTE=120
SWARA_LOG_LEVEL=INFO
