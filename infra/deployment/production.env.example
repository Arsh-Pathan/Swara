# Swara Production Environment Configuration Template
# Copy to .env or inject through your container secret manager

# Server binding
SWARA_API_HOST=0.0.0.0
SWARA_API_PORT=8000

# Authentication & Access Control
# Set a strong 32+ character random string for production deployments
# When unset, API is open for local development on localhost
SWARA_API_KEY=

# Storage & Paths
SWARA_MODELS_DIR=/app/models/cache
SWARA_SPEAKER_STORE_PATH=/app/data/speakers

# Inference Hardware & Thread Tuning
SWARA_EXECUTION_PROVIDER=CPUExecutionProvider
SWARA_INTRA_OP_NUM_THREADS=4
SWARA_INTER_OP_NUM_THREADS=2
SWARA_USE_INT8_MODEL=false

# Algorithm Thresholds
SWARA_IDENTIFICATION_THRESHOLD=0.68
SWARA_UNKNOWN_THRESHOLD=0.60
SWARA_DIARIZATION_CLUSTERING_THRESHOLD=0.65
SWARA_DIARIZATION_IDENTITY_MATCH_THRESHOLD=0.70

# Audio Constraints
SWARA_MAX_AUDIO_DURATION_SECONDS=1800.0
SWARA_MAX_AUDIO_UPLOAD_SIZE_MB=50.0

# Rate Limiting
SWARA_RATE_LIMIT_PER_MINUTE=120
SWARA_LOG_LEVEL=INFO
